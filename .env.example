# Configuration Supabase (backend partagé).
# Copiez ce fichier en .env.local et renseignez les valeurs depuis
# le dashboard Supabase : Settings → API.
# Sans ces variables, l'app fonctionne en mode local (données sur l'appareil).
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON


# Paiement KKiaPay — clé PUBLIQUE du tableau de bord Sandbox.
# À définir aussi dans Vercel (Preview) pour tester le widget.
# Ne JAMAIS mettre ici la clé privée ni la clé secrète : elles restent côté
# serveur, dans les variables d'environnement Vercel.
VITE_KKIAPAY_PUBLIC_KEY=

# Bac à sable KKiaPay — REPLI seulement : le mode réel se choisit désormais
# dans l'app (Plus → Moyens de paiement). Ces variables ne servent que tant
# qu'aucun agrégateur n'y est configuré.
# En bac à sable, seuls les numéros de test KKiaPay fonctionnent (+229 97 00 00 00,
# +229 68 00 00 00…) : un vrai numéro togolais est refusé.
VITE_KKIAPAY_SANDBOX=true


# ---------------------------------------------------------------------------
# VÉRIFICATION SERVEUR DES PAIEMENTS — variables Vercel uniquement.
# Sans préfixe VITE_ : elles ne doivent JAMAIS entrer dans le bundle du
# navigateur. Ne les mettez pas dans un .env local partagé.
#
# Sans elles, /api/paiement/verifier répond 503 et l'app retombe sur la
# validation manuelle de l'abonnement par le gérant — rien ne casse.
# ---------------------------------------------------------------------------
# Clés PRIVÉE et SECRÈTE du tableau de bord KkiaPay (onglet correspondant au
# mode utilisé : Sandbox pour les tests, Live en production).
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# Clé service_role Supabase (Settings → API → service_role). Elle contourne la
# RLS : elle vaut un accès total à la base. À traiter comme un mot de passe.
SUPABASE_SERVICE_ROLE_KEY=


# Suivi des plantages (facultatif) — Sentry.
# DSN du projet : Sentry → Settings → Client Keys (DSN). C'est une valeur
# PUBLIQUE, faite pour vivre dans le navigateur.
# Sans elle, le SDK n'est même pas inclus dans le bundle : zéro octet envoyé,
# zéro octet téléchargé. Le journal maison (/api/erreur) reste en service.
VITE_SENTRY_DSN=

# Envoi des source maps à Sentry, au BUILD (variables Vercel, jamais ici).
# Sans elles, les piles d'appel restent minifiées et illisibles — c'est
# l'essentiel de l'intérêt de Sentry.
# Jeton : Sentry → Settings → Auth Tokens, portée « project:releases ».
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=


# Analytique produit (facultatif) — PostHog.
# Sans ces variables, aucun événement n'est émis : zéro octet.
#
# ⚠️ DEUX CLÉS EXISTENT DANS POSTHOG, ET UNE SEULE VA ICI :
#   • « phc_… » = clé de PROJET, publique, faite pour le navigateur. C'est
#     celle-ci (Settings → Project → Project API Key).
#   • « phx_… » = clé PERSONNELLE. C'est un MOT DE PASSE : elle donne accès à
#     tout le compte. Une variable VITE_ part telle quelle dans le bundle
#     téléchargé par chaque visiteur — n'y mettez jamais une clé « phx_ ».
VITE_POSTHOG_KEY=
# ⚠️ Ici une ADRESSE, pas une clé : les deux variables se collent l'une après
# l'autre et sont faciles à intervertir. Une adresse qui n'est pas une URL
# absolue est traitée comme un chemin relatif : les événements partent sur
# notre propre serveur, qui répond « 405 ».
# La RÉGION doit correspondre à celle du projet : un projet créé sur
# us.posthog.com ne reçoit RIEN des envois vers « eu », et inversement — sans
# le moindre message d'erreur. À lire dans l'adresse de votre tableau de bord.
VITE_POSTHOG_HOST=https://us.i.posthog.com


# Sommaire minuté des vidéos de formation (facultatif).
# Variable SERVEUR (pas de préfixe VITE_) : à définir dans Vercel uniquement,
# elle ne doit jamais partir dans le bundle du navigateur.
# Sans elle, /api/youtube lit la page publique de la vidéo — ça marche aussi,
# c'est juste plus sensible aux changements de mise en page de YouTube.
# Clé « YouTube Data API v3 » depuis la console Google Cloud.
YOUTUBE_API_KEY=
